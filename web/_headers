# Security headers for Cloudflare Pages (the "! Header" detach lines are its syntax; other hosts may merge the
# per-page policy with the default, which turns serial/bluetooth off: safe, but set them in the host's settings).
# On other hosts, set the same headers in the host's settings. The CSP itself is a <meta> tag in each page.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), serial=(), bluetooth=()
/robot.html
  ! Permissions-Policy
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), serial=(self), bluetooth=()
/pilot.html
  ! Permissions-Policy
  Permissions-Policy: bluetooth=(self), camera=(self), accelerometer=(self), gyroscope=(self), magnetometer=(), screen-wake-lock=(self), microphone=(self), geolocation=(), serial=()
/pilot
  ! Permissions-Policy
  Permissions-Policy: bluetooth=(self), camera=(self), accelerometer=(self), gyroscope=(self), magnetometer=(), screen-wake-lock=(self), microphone=(self), geolocation=(), serial=()
/robot
  ! Permissions-Policy
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), serial=(self), bluetooth=()
# voice input (SpeechRecognition) needs the microphone: only on the Phone Brain page
# the free *.pages.dev address is a preview: never indexed by search engines (the custom domain is not affected)
https://:project.pages.dev/*
  X-Robots-Tag: noindex
# private or retired pages: never in search results (the pages also carry a robots meta tag)
/agents.html
  X-Robots-Tag: noindex
/agents
  X-Robots-Tag: noindex
/agent.html
  X-Robots-Tag: noindex, follow
/agent
  X-Robots-Tag: noindex, follow
/world.html
  X-Robots-Tag: noindex
/world
  X-Robots-Tag: noindex
/pilot.webmanifest
  Content-Type: application/manifest+json
/deployment.json
  Cache-Control: no-cache
