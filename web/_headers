# Security headers for Cloudflare Pages (the "! Header" detach lines are its syntax; other hosts may merge the
# per-page policy with the default, which turns serial/bluetooth off: safe, but set them in the host's settings).
# On other hosts, set the same headers in the host's settings. The CSP itself is a <meta> tag in each page.
# "! Link": Cloudflare turns the pages' <link rel="modulepreload"> tags into an HTTP Link header (Early Hints). The browser
# acts on it before it reads the page's import map, so every module that imports "three" fails to resolve and the 3D
# pages (Proving Grounds, Robot Link, Codex, Bench) stay blank. The tags in <head>, after the import map, still preload.
/*
  ! Link
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), serial=(), bluetooth=(), xr-spatial-tracking=()
/js/ar/vision/detect-worker.js
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'
/ar.html
  ! Permissions-Policy
  Permissions-Policy: camera=(self), microphone=(), xr-spatial-tracking=(self), accelerometer=(self), gyroscope=(self), magnetometer=(), screen-wake-lock=(self), geolocation=(), serial=(), bluetooth=()
/ar
  ! Permissions-Policy
  Permissions-Policy: camera=(self), microphone=(), xr-spatial-tracking=(self), accelerometer=(self), gyroscope=(self), magnetometer=(), screen-wake-lock=(self), geolocation=(), serial=(), bluetooth=()
/robot.html
  ! Permissions-Policy
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), serial=(self), bluetooth=(), xr-spatial-tracking=()
/pilot.html
  ! Permissions-Policy
  Permissions-Policy: bluetooth=(self), camera=(self), accelerometer=(self), gyroscope=(self), magnetometer=(), screen-wake-lock=(self), microphone=(self), geolocation=(), serial=(), xr-spatial-tracking=()
/pilot
  ! Permissions-Policy
  Permissions-Policy: bluetooth=(self), camera=(self), accelerometer=(self), gyroscope=(self), magnetometer=(), screen-wake-lock=(self), microphone=(self), geolocation=(), serial=(), xr-spatial-tracking=()
/robot
  ! Permissions-Policy
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), serial=(self), bluetooth=(), xr-spatial-tracking=()
# voice input (SpeechRecognition) needs the microphone: only on the Phone Brain page; AR (WebXR) only on /ar
# the free *.pages.dev address is a preview: never indexed by search engines (the custom domain is not affected)
https://:project.pages.dev/*
  X-Robots-Tag: noindex
# private or retired pages: never in search results (the pages also carry a robots meta tag)
/agents.html
  X-Robots-Tag: noindex
/agents
  X-Robots-Tag: noindex
/agent.html
  X-Robots-Tag: noindex, follow
/agent
  X-Robots-Tag: noindex, follow
/world.html
  X-Robots-Tag: noindex
/world
  X-Robots-Tag: noindex
/pilot.webmanifest
  Content-Type: application/manifest+json
/deployment.json
  Cache-Control: no-cache
# Cache (Cloudflare): pages, JS and CSS keep the default (revalidated on every visit with an ETag, so a deploy is seen
# at once and never half old, half new); the vendored libraries change only with a dependency upgrade (a day, then
# refreshed in the background); the fonts only with a font upgrade. No two rules match the same path (Cloudflare would
# join their values).
/vendor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
