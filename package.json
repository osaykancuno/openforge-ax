{
  "name": "openforge-ax",
  "version": "0.1.0",
  "private": true,
  "license": "CC0-1.0",
  "description": "OpenForge AX - embodied agent NFTs on Ethereum (ERC-721 + ERC-6551)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "art:preview": "node art/generate.mjs --preview 24",
    "art:build": "node art/generate.mjs",
    "web:build": "node scripts/build-web.mjs",
    "serve": "node scripts/serve.mjs 8080",
    "node": "hardhat node",
    "demo": "hardhat run scripts/demo-local.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "reveal:sepolia": "hardhat run scripts/reveal.js --network sepolia",
    "reveal:mainnet": "hardhat run scripts/reveal.js --network mainnet",
    "finalize:sepolia": "hardhat run scripts/finalize.js --network sepolia",
    "finalize:mainnet": "hardhat run scripts/finalize.js --network mainnet",
    "site:check": "node scripts/check-site.mjs",
    "site:smoke": "node scripts/site-smoke.mjs",
    "assets": "node scripts/assets.mjs",
    "brand": "node scripts/brand.mjs",
    "marketing": "node scripts/marketing.mjs",
    "post-reveal": "node scripts/post-reveal.mjs",
    "kpi": "node scripts/kpi.mjs",
    "trials:export": "node scripts/trials-export.mjs",
    "rehearsal:fork": "hardhat --config hardhat.sepolia-fork.config.js run scripts/rehearsal.js",
    "rehearsal:sepolia": "hardhat run scripts/rehearsal.js --network sepolia",
    "proving": "node scripts/proving-server.mjs",
    "world": "node scripts/world-server.mjs",
    "test:fork": "hardhat --config hardhat.fork.config.js test test/fork/MainnetFork.test.js",
    "deploy:fork": "hardhat --config hardhat.fork.config.js run scripts/deploy.js",
    "selfhost": "node scripts/selfhost.mjs",
    "local": "node scripts/local-lab.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "dotenv": "^18.0.9",
    "ethers": "^6.17.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "hardhat": "^2.22.19",
    "hardhat-gas-reporter": "^1.0.10",
    "puppeteer-core": "^25.16.0",
    "solidity-coverage": "^0.8.17",
    "three": "0.160.0",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^7.0.2"
  }
}
