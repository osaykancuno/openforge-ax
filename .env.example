# NEVER commit the .env file. Use a dedicated deploy key with minimal funds.
# Lines marked YOU are the only ones you fill in; `npm run assets` writes the image links and PROVENANCE_HASH itself.
PRIVATE_KEY=           # YOU: private key of a NEW wallet used only for the deploy (MetaMask → account details → show private key)
MAINNET_RPC_URL=       # optional: empty = public RPC
SEPOLIA_RPC_URL=       # optional: empty = public RPC
SEPOLIA_PRIVATE_KEY=   # test-only key for Sepolia rehearsals (never the mainnet key; empty = no Sepolia account)
SEPOLIA_GAS_PRICE_WEI= # optional gas price on Sepolia
HOST=                  # optional: interface the local servers bind to (default 127.0.0.1 on the local demo; 0.0.0.0 to test from a phone on your LAN)
ETHERSCAN_API_KEY=     # optional: free key at etherscan.io/myapikey, verifies the contracts automatically
PINATA_JWT=            # optional: images on IPFS (pinata.cloud → API Keys → New key → JWT); empty = the site serves them

# Collection
OWNER=                 # YOU: address of your Safe (safe.global); required on mainnet
TREASURY=              # YOU: address that receives mint proceeds and royalties (the Safe is fine)
MAX_SUPPLY=1024        # max 1024 (unique callsigns)
TEAM_RESERVE=100
ROYALTY_BPS=500
REVEAL_DEADLINE_DAYS=30   # sale window from deploy; the Safe can extend it by up to 90 days
PROVENANCE_HASH=       # written by npm run assets
LICENSE=               # empty = "CC0 1.0 Universal - https://creativecommons.org/publicdomain/zero/1.0/"
ATTESTER=              # initial attester (optional)
EXTERNAL_URL=          # YOU: the site's https:// address (for example https://openforge-ax.pages.dev)
PLACEHOLDER_IMAGE=     # written by npm run assets
COLLECTION_IMAGE=      # written by npm run assets
COLLECTION_BANNER=     # written by npm run assets

# Public drop (optional: can also be configured in OpenSea Studio)
# Prices agreed 2026-10-25: allowlist 0.01 ETH (set in OpenSea Studio, with the list), public 0.015 ETH.
PUBLIC_PRICE_ETH=0.015
PUBLIC_START=          # unix timestamp
PUBLIC_END=
MAX_PER_WALLET=3
OPENSEA_FEE_BPS=1000   # check the primary fee in OpenSea Studio

# Proving Grounds (after launch)
SIM_ATTESTER=          # address allowed to batch-attest simulated runs (server hot key, minimal ETH)
SIM_ATTESTER_KEY=      # its private key, used only by scripts/proving-server.mjs
PROVING_API=           # public URL of the verifier, e.g. https://proving.openforge.example
WORLD_WS=              # public WebSocket URL of the Neo-Forge server, e.g. wss://world.openforge.example
ALLOWED_ORIGINS=       # site origin(s) allowed to connect to the world server
